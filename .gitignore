# Raw source data and experiment artifacts are local inputs/outputs.  Keep only
# the small demo subset under version control.
data/raw/train-2025.csv
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
reports/metrics/*
!reports/metrics/.gitkeep
reports/model_development/
reports/figures/*
!reports/figures/.gitkeep
# Keep the first shared model-review figure set under version control; other
# generated model figures remain local artifacts.
!reports/figures/model_test_v1/
!reports/figures/model_test_v1/**
model_artifacts/*
!model_artifacts/.gitkeep

__pycache__/
.pytest_cache/
.venv/
*.py[cod]
