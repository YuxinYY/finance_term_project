# data: raw is read-only and too large for git; interim/derived files are regenerated by code
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
# splits: keep only the README; split files are rebuilt by src/data scripts
data/splits/*
!data/splits/.gitkeep
!data/splits/README.md
*.parquet
# python / OS
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
.DS_Store
*.pkl
.*.out
experiments/calibration/cache/
