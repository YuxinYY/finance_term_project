{
  "schema_version": "1.1.0",
  "candidate_note": "Historical schema augmented with unimplemented RiskCalc-inspired candidates; not the active preprocessing contract. Ratios require denominator and missing-value policies before implementation.",
  "riskcalc_candidate_definitions": {
    "net_income_to_assets": {"formula": "profit / asst_tot", "reference": "Section IV, pp. 32-33"},
    "net_income_less_extraordinary_to_assets": {"formula": "(profit - inc_extraord) / asst_tot", "reference": "Section IV, p. 33", "note": "Approximation: inc_extraord is income, not necessarily net extraordinary items; tax effects may differ."},
    "return_on_equity": {"formula": "profit / eqty_tot", "reference": "Section IV, p. 33", "note": "Negative or near-zero equity can make this ratio misleading."},
    "liabilities_to_assets": {"formula": "(asst_tot - eqty_tot) / asst_tot", "reference": "Section IV, p. 34", "note": "Accounting-identity proxy for liabilities; depends on consistent reported assets and equity."},
    "total_debt_to_assets": {"formula": "(debt_st + debt_lt) / asst_tot", "reference": "Section IV, p. 34", "note": "Debt totals are a dataset-specific proxy and may include non-financial liabilities."},
    "liabilities_to_tangible_assets": {"formula": "(asst_tot - eqty_tot) / (asst_tot - asst_intang_fixed)", "reference": "Section IV, p. 34", "note": "Approximation; goodwill and other intangibles may need separate treatment."},
    "short_to_long_term_debt": {"formula": "debt_st / debt_lt", "reference": "Section IV, p. 36"},
    "receivables_to_cogs": {"formula": "AR / COGS", "reference": "Section IV, p. 37"},
    "payables_to_cogs": {"formula": "AP_st / COGS", "reference": "Section IV, p. 37", "note": "Short-term payables proxy; total payables would include AP_lt."}
  },
